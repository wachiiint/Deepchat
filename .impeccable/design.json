  "narrative": {
    "northStar": "Deep Water, One Light",
    "overview": "Deepchat is a category-standard chat client played straight: one quiet sidebar, one message column, nothing decorative. The world is a rich deep-ocean navy that never falls to black, layered in three tonal steps (sidebar deeper than the room, raised fields lighter than both) and divided by 1px hairlines. A single flat aqua is the only light in the water; it marks actions, the current selection, and unread counts, always carrying navy text on top and never glowing.\n\nDensity is desktop-chat density: 32px rows, 56px headers, 14px body text, a 264px sidebar. Everything protocol-backed is visible at a glance; nothing is hidden behind novelty. The direction rejected novel metaphors (a transit-map concept) and the purple/glow AI-app look.\n\nErrors are placed where the action happened, never in a generic global slot unless no local place exists.",
    "keyCharacteristics": [
      "Navy tonal layering, no black, no gradients.",
      "One flat aqua accent with navy ink on it; no glow.",
      "Green means online and nothing else; red means error and nothing else.",
      "Soft 6–10px corners, 1px lines, bundled Inter Variable.",
      "Left-aligned message feed with hashed-colour initial avatars."
    ],
    "rules": [
      {
        "name": "The One Light Rule",
        "body": "Aqua is the only accent. It fills actions and unread counts, tints the selection, and is never used as a glow or gradient.",
        "section": "colors"
      },
      {
        "name": "The Semantic Lock Rule",
        "body": "Green is presence, red is error, aqua is selection/action/unread. None appears decoratively, and avatar fills stay within blues, slates and earth tones.",
        "section": "colors"
      },
      {
        "name": "The Never Black Rule",
        "body": "The darkest surface is Trench Navy; depth comes from navy steps, not black.",
        "section": "colors"
      },
      {
        "name": "The Weight Not Size Rule",
        "body": "Distinguish by weight and the ink/mute/faint ladder; keep sizes within 11–16px inside the app, with 24px reserved for the connect heading.",
        "section": "typography"
      },
      {
        "name": "The Tabular Count Rule",
        "body": "Counts, timestamps and host:port use `font-variant-numeric: tabular-nums`.",
        "section": "typography"
      },
      {
        "name": "The Float-Only Shadow Rule",
        "body": "Only overlays that leave the layout flow (popover, toast) cast the shadow; rows, cards and fields never do.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** layer surfaces side → bg → raise and separate them with 1px hairlines.",
      "**Do** put navy `accent-ink` text on every aqua fill.",
      "**Do** place errors where the action happened: under the field, inside the create box, above the composer; toasts only for errors with no local home.",
      "**Do** keep counts, times and host:port tabular.",
      "**Do** honour reduced motion by zeroing movement and duration."
    ],
    "donts": [
      "**Don't** use black, purple, gradients or glow; the direction rejected the purple/glow AI-app look.",
      "**Don't** use green for anything but presence or red for anything but errors.",
      "**Don't** cast shadows on in-flow surfaces; only the popover and toasts float.",
      "**Don't** add a second accent colour.",
      "**Don't** right-align your own messages into bubbles; the feed is left-aligned for everyone."
    ]
  }
}
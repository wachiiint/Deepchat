# Copy to .env and fill in. Never commit .env.

# Google AI Studio (Gemini, OpenAI-compatible endpoint)
DEEPCHAT_AI_URL=https://generativelanguage.googleapis.com/v1beta/openai
DEEPCHAT_AI_MODEL=gemini-2.5-flash
DEEPCHAT_AI_KEY=your-key-here

# Local Ollama instead: comment the 3 lines above, uncomment these
# DEEPCHAT_AI_URL=http://localhost:11434/v1
# DEEPCHAT_AI_MODEL=llama3.2:1b
